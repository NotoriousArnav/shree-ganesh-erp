{
  "name": "ganesha-merchant-assistive-software",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "mushak/frontend",
    "mushak/backend",
    "lokkhi/frontend",
    "lokkhi/backend"
  ],
  "scripts": {
    "build:packages": "npm run build -w packages/db && npm run build -w packages/shared && npm run build -w packages/server",
    "build": "npm run build:packages && npm run build:mushak && npm run build:lokkhi",
    "dev:mushak": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w mushak/frontend\" \"npm run dev -w mushak/backend\"",
    "build:mushak": "npm run build -w mushak/frontend -w mushak/backend",
    "dev:lokkhi": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w lokkhi/frontend\" \"npm run dev -w lokkhi/backend\"",
    "build:lokkhi": "npm run build -w lokkhi/frontend -w lokkhi/backend",
    "test": "node --import tsx --test \"mushak/**/*.test.ts\" \"lokkhi/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\"",
    "test:mushak": "node --import tsx --test \"mushak/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\"",
    "test:lokkhi": "node --import tsx --test \"lokkhi/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"mushak/**/*.test.ts\" \"lokkhi/**/*.test.ts\" \"packages/shared/src/**/*.test.ts\"",
    "prod-env:mushak": "DOTENV_CONFIG_PATH=.env.production npm run start -w mushak/backend",
    "prod-env:lokkhi": "DOTENV_CONFIG_PATH=.env.production npm run start -w lokkhi/backend",
    "db:up": "npm run db:up -w mushak/backend",
    "db:down": "npm run db:down -w mushak/backend",
    "db:migrate": "npm run db:migrate -w mushak/backend",
    "db:studio": "npm run db:studio -w mushak/backend",
    "seed:admin": "npm run seed:admin -w mushak/backend",
    "seed:demo": "npm run seed:demo -w mushak/backend",
    "user:create": "npm run user:create -w mushak/backend --",
    "mail:test": "npm run mail:test -w mushak/backend --",
    "docs:openapi": "npm run docs:openapi -w mushak/backend",
    "docs:all": "node scripts/build-docs.mjs all",
    "docs:mushak": "node scripts/build-docs.mjs mushak",
    "docs:lokkhi": "node scripts/build-docs.mjs lokkhi"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.23.15",
    "vite": "^5.4.21"
  }
}
