{
  "name": "ganesha-merchant-assistive-software",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "mushak/frontend",
    "mushak/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w mushak/frontend",
    "dev:backend": "npm run dev -w mushak/backend",
    "build:frontend": "npm run build -w mushak/frontend",
    "build:backend": "npm run build -w mushak/backend",
    "build": "npm run build -w mushak/frontend && npm run build -w mushak/backend",
    "dev:mushak": "npm run dev --workspaces",
    "build:mushak": "npm run build --workspaces",
    "db:up": "npm run db:up -w mushak/backend",
    "db:down": "npm run db:down -w mushak/backend",
    "db:migrate": "npm run db:migrate -w mushak/backend",
    "db:studio": "npm run db:studio -w mushak/backend",
    "seed:admin": "npm run seed:admin -w mushak/backend",
    "user:create": "npm run user:create -w mushak/backend --"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
