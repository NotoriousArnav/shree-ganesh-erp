# Server
HOST=0.0.0.0
PORT=8080

# Postgres (docker compose)
POSTGRES_USER=mushak
POSTGRES_PASSWORD=mushak_dev_password
POSTGRES_DB=mushak
POSTGRES_PORT=5432

# Connection string used by the app and drizzle-kit.
# For a managed/serverless Postgres (Neon, Supabase, Vercel Postgres), replace this
# with the provider URL. Keep `prepare: false` in src/db.ts for pooled connections.
DATABASE_URL=postgres://mushak:mushak_dev_password@localhost:5432/mushak

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
# Extra origins allowed to call the auth API (comma-separated).
# In development the machine's LAN IPv4 addresses are trusted automatically,
# so a phone on the same Wi-Fi can use http://<lan-ip>:5173 without changes.
# Set this explicitly for deployed frontends on other domains.
# TRUSTED_ORIGINS=https://shop.example.com,http://192.168.1.42:5173

# First super admin (used by `npm run seed:admin`)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@mushak.local
ADMIN_PASSWORD=change-me-mushak-admin

# Mail
# console: print to the terminal and save .eml/.json files (development only)
MAIL_DRIVER=console
MAIL_FROM=Mushak <no-reply@mushak.local>
MAIL_DIR=/tmp/mushak-mail

# Object storage (RustFS / MinIO / AWS S3)
# Start the bundled container with `npm run db:up` (it also starts RustFS).
# The driver creates the bucket on first use.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mushakadmin
S3_SECRET_KEY=mushak_dev_storage_secret
S3_BUCKET=mushak
# Path-style addressing is required by RustFS and MinIO.
S3_FORCE_PATH_STYLE=true
# Optional public/CDN base for permanent links, e.g. https://cdn.example.com/mushak
# S3_PUBLIC_URL=
