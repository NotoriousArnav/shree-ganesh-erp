# Server
HOST=0.0.0.0
PORT=8081

# Product name used in mail and the OpenAPI document.
APP_NAME=Lokkhi

# Postgres: the same database as Mushak, so shops, users and stock are shared.
DATABASE_URL=postgres://mushak:mushak_dev_password@localhost:5432/mushak

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-the-same-secret-as-mushak
BETTER_AUTH_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5175
# Extra origins allowed to call the auth API (comma-separated).
# TRUSTED_ORIGINS=https://lokkhi.example.com

# Mail (shared implementation with Mushak)
MAIL_DRIVER=console
MAIL_FROM=Lokkhi <no-reply@lokkhi.local>
MAIL_DIR=/tmp/lokkhi-mail
