# Server
HOST=0.0.0.0
PORT=8080

# Postgres (docker compose). Copy this file to .env and adjust as needed.
POSTGRES_USER=mushak
POSTGRES_PASSWORD=mushak_dev_password
POSTGRES_DB=mushak
POSTGRES_PORT=5432

DATABASE_URL=postgres://mushak:mushak_dev_password@localhost:5432/mushak

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# First super admin (used by `npm run seed:admin`)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@mushak.local
ADMIN_PASSWORD=change-me-mushak-admin

# Mail
MAIL_DRIVER=console
MAIL_FROM=Mushak <no-reply@mushak.local>
MAIL_DIR=/tmp/mushak-mail
