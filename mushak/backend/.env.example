# Server
HOST=0.0.0.0
PORT=8080

# Postgres (docker compose)
POSTGRES_USER=mushak
POSTGRES_PASSWORD=mushak_dev_password
POSTGRES_DB=mushak
POSTGRES_PORT=5432

# Connection string used by the app and drizzle-kit.
# For a managed/serverless Postgres (Neon, Supabase, Vercel Postgres), replace this
# with the provider URL. Keep `prepare: false` in src/db.ts for pooled connections.
DATABASE_URL=postgres://mushak:mushak_dev_password@localhost:5432/mushak
